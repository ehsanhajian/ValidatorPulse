# Active chain plugin: ethereum (implemented).
# Reserved: polkadot, cosmos, solana (clear error until implemented).
CHAIN=ethereum

# Beacon node HTTP API (required for live Ethereum monitoring)
BEACON_API_URL=http://127.0.0.1:5052

# --- Which validators to monitor (use either or both) ---
# Numeric indices from your beacon / explorer:
VALIDATOR_INDICES=123456,789012

# BLS pubkeys — the usual "validator address" (0x + 96 hex chars).
# Example: from deposit data, validator client, or beaconcha.in
VALIDATOR_PUBKEYS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Poll interval in seconds
POLL_INTERVAL_SECONDS=12

# Demo mode (true/false). Also auto-enabled when BEACON_API_URL is unset.
# Set false when pointing at a real beacon node.
DEMO_MODE=true

# Server bind
HOST=127.0.0.1
PORT=3000

# Alert channels (configure only what you use)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SLACK_WEBHOOK_URL=

DISCORD_WEBHOOK_URL=

WEBHOOK_URL=

PAGERDUTY_ROUTING_KEY=

# Alert thresholds
ALERT_MISSED_ATTESTATIONS=2
ALERT_EFFECTIVENESS_BELOW=95
ALERT_SLASHING_RISK_ABOVE=40
ALERT_DISK_USAGE_ABOVE=85
ALERT_CLOCK_DRIFT_MS=500
