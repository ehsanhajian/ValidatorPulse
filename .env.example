# Active chain plugin: ethereum | polkadot | cosmos | solana | near | cardano (implemented).
CHAIN=ethereum

# --- Ethereum ---
# Beacon node HTTP API (required for live Ethereum monitoring).
# Full URL: http or https, any port, optional path prefix.
# BEACON_API_URL=http://127.0.0.1:5052
# BEACON_API_URL=https://beacon.example.com
# BEACON_API_URL=https://beacon.example.com:8443
BEACON_API_URL=http://127.0.0.1:5052

# Numeric indices from your beacon / explorer:
VALIDATOR_INDICES=123456,789012

# BLS pubkeys — the usual "validator address" (0x + 96 hex chars).
VALIDATOR_PUBKEYS=

# --- Polkadot ---
# Role: collator (parachain) or validator (relay NPoS).
# CHAIN=polkadot-relay is an alias that forces POLKADOT_ROLE=validator.
# POLKADOT_ROLE=collator
# POLKADOT_ROLE=validator

# Substrate HTTP(S) JSON-RPC:
#   collator → parachain / collator node
#   validator → relay-chain node
# Full URL: http or https, any port (reverse proxies welcome).
# SUBSTRATE_RPC_URL=http://127.0.0.1:9933
# SUBSTRATE_RPC_URL=https://rpc.example.com
# SUBSTRATE_RPC_URL=https://rpc.example.com:8443
SUBSTRATE_RPC_URL=http://127.0.0.1:9933

# Shared RPC TLS / connect policy (Beacon, Substrate, future adapters)
# RPC_TLS_VERIFY=true
# RPC_TLS_CA_BUNDLE=/path/to/ca.pem
# RPC_TLS_INSECURE=false
# RPC_CONNECT_TIMEOUT_SECONDS=8

# Parachain collator SS58 addresses (POLKADOT_ROLE=collator)
COLLATOR_ADDRESSES=

# Relay validator stash SS58 addresses (POLKADOT_ROLE=validator)
VALIDATOR_STASH_ADDRESSES=

# Parachain id — sets labeling + native token for collators when known:
#   (unset) DOT
#   1000 Asset Hub / DOT
#   2000 Acala / ACA
#   2004 Moonbeam / GLMR
#   2006 Astar / ASTR
#   2030 Bifrost / BNC
#   2034 Hydration / HDX
#   2035 Phala / PHA
#   2046 Manta / MANTA
#   2007 Shiden / SDN
#   2023 Moonriver / MOVR
# Ignored for relay validators (DOT unless overridden).
# PARACHAIN_ID=2006

# --- Cosmos SDK / CometBFT ---
# Profile selects Bech32 prefixes + default token (cosmoshub | celestia).
# COSMOS_PROFILE=cosmoshub
# COSMOS_PROFILE=celestia
# COSMOS_CHAIN_ID=cosmoshub-4
# LCD (REST) and/or CometBFT RPC — either enables live mode when DEMO_MODE=false.
# COSMOS_REST_URL=http://127.0.0.1:1317
# COSMOS_RPC_URL=http://127.0.0.1:26657
# COSMOS_GRPC_URL=127.0.0.1:9090
# Comma-separated validator operator addresses (valoper… / celestiavaloper…).
# COSMOS_VALIDATOR_OPERATOR_ADDRESSES=cosmosvaloper1...
# Optional token override (otherwise profile default: ATOM / TIA):
# REWARD_TOKEN_SYMBOL=ATOM
# REWARD_TOKEN_DECIMALS=6

# --- Solana ---
# SOLANA_RPC_URL=http://127.0.0.1:8899
# Comma-separated vote account pubkeys (preferred):
# VALIDATOR_VOTE_ACCOUNTS=Vote1111...,Vote2222...
# Optional identity pubkeys when vote accounts are unknown:
# SOLANA_IDENTITY_PUBKEYS=Node1111...
# ALERT_SKIP_RATE_ABOVE=10
# Optional token override (default SOL / 9 / lamports):
# REWARD_TOKEN_SYMBOL=SOL
# REWARD_TOKEN_DECIMALS=9

# --- NEAR ---
# NEAR_RPC_URL=http://127.0.0.1:3030
# Comma-separated validator / pool account IDs:
# NEAR_VALIDATOR_ACCOUNT_IDS=pool1.near,pool2.near
# Optional nearcore Prometheus metrics (soft-fail if unavailable):
# NEAR_METRICS_URL=http://127.0.0.1:3030/metrics
# Optional token override (default NEAR / 24 / yoctoNEAR):
# REWARD_TOKEN_SYMBOL=NEAR
# REWARD_TOKEN_DECIMALS=24

# --- Cardano ---
# CARDANO_TRACER_URL=http://127.0.0.1:12789
# CARDANO_POOL_IDS=pool1...,pool2...
# CARDANO_NODE_NAME=block-producer
# CARDANO_NETWORK=mainnet
# Optional node socket (tip/sync enrichment only; never read VRF/KES secrets):
# CARDANO_NODE_SOCKET_PATH=/run/cardano/node.socket
# ALERT_CARDANO_KES_WARNING=5
# ALERT_CARDANO_KES_CRITICAL=1
# Optional token override (default ADA / 6 / lovelace):
# REWARD_TOKEN_SYMBOL=ADA
# REWARD_TOKEN_DECIMALS=6

# --- Tezos ---
# TEZOS_RPC_URL=http://127.0.0.1:8732
# Comma-separated baker delegate addresses (tz1…):
# TEZOS_BAKER_ADDRESSES=tz1...,tz2...
# Optional OpenMetrics / baker log enrichment (soft-fail if unavailable):
# TEZOS_METRICS_URL=http://127.0.0.1:9091/metrics
# TEZOS_BAKER_LOG_PATH=/var/log/tezos/baker.log
# ALERT_TEZOS_REMAINING_MISSES_BELOW=2
# Optional token override (default XTZ / 6 / mutez):
# REWARD_TOKEN_SYMBOL=XTZ
# REWARD_TOKEN_DECIMALS=6

# --- Algorand ---
# ALGORAND_ALGOD_URL=http://127.0.0.1:8080
# Prefer token file; plain token also accepted (never logged/exposed):
# ALGORAND_ALGOD_TOKEN_FILE=/var/lib/algorand/algod.token
# ALGORAND_ALGOD_TOKEN=
# ALGORAND_ACCOUNT_ADDRESSES=ABC...,XYZ...
# Optional Prometheus metrics (soft-fail if unavailable):
# ALGORAND_METRICS_URL=http://127.0.0.1:9100/metrics
# ALERT_ALGORAND_PARTKEY_WARNING_ROUNDS=50000
# ALERT_ALGORAND_HEARTBEAT_GAP_ROUNDS=10000
# Optional token override (default ALGO / 6 / microAlgos):
# REWARD_TOKEN_SYMBOL=ALGO
# REWARD_TOKEN_DECIMALS=6

# Only set these if your parachain id is NOT in the list above
# (otherwise the app already picks the token from PARACHAIN_ID).
# REWARD_TOKEN_SYMBOL=ASTR
# REWARD_TOKEN_DECIMALS=18

# Fetch operator display names; hover always shows the full address/pubkey.
# Ethereum fallback order: beaconcha.in -> Rated -> ENS -> recent graffiti.
FETCH_OPERATOR_NAMES=true
# SUBSCAN_API_KEY=
# BEACONCHA_BASE_URL=https://beaconcha.in
# BEACONCHA_API_KEY=
# Rated operator/pool mapping requires an API key.
# RATED_API_KEY=
# RATED_API_BASE_URL=https://api.rated.network
# RATED_NETWORK=mainnet
# ENS reverse lookup is opt-in. ENSWhois allows 5 unauthenticated requests/minute.
ENS_LOOKUP_ENABLED=false
# ENS_API_KEY=
# ENS_API_BASE_URL=https://api.enswhois.com

# Poll interval in seconds
POLL_INTERVAL_SECONDS=12

# Demo mode (true/false). Also auto-enabled when the chain RPC URL is unset.
DEMO_MODE=true

# Server bind
HOST=127.0.0.1
PORT=3000

# Optional web panel / API credentials (both required to enable HTTP Basic auth).
# When unset, local demo stays open. Strongly recommended if HOST is not loopback.
# WEB_AUTH_USERNAME=<username>
# WEB_AUTH_PASSWORD=<password>
# Optional Prometheus scrape token for GET /api/metrics (Bearer, X-Metrics-Token, or ?token=).
# Works with or without WEB_AUTH_*; does not unlock the dashboard.
# WEB_METRICS_TOKEN=scrape-token-here

# Alert channels (configure only what you use)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SLACK_WEBHOOK_URL=

DISCORD_WEBHOOK_URL=

WEBHOOK_URL=

PAGERDUTY_ROUTING_KEY=

# Alert thresholds
ALERT_MISSED_ATTESTATIONS=2
ALERT_EFFECTIVENESS_BELOW=95
ALERT_SLASHING_RISK_ABOVE=40
# Relay validators: warn when era points fall below this value
ALERT_LOW_ERA_POINTS_BELOW=40
ALERT_DISK_USAGE_ABOVE=85
ALERT_CLOCK_DRIFT_MS=500
