# Copy to `.env` (Compose reads it for substitution) and/or `.env.local`
# (loaded into the app container). Do not commit real secrets.
#
#   cp compose.env.example .env
#   docker compose up --build
#
# Full chain / alert variables: see `.env.example`.

CHAIN=ethereum
DEMO_MODE=true

# Host node from inside Compose: use host.docker.internal, not 127.0.0.1.
# BEACON_API_URL=http://host.docker.internal:5052
# VALIDATOR_INDICES=123456,789012

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=

# Recommended when Caddy is reachable beyond this machine.
# WEB_AUTH_USERNAME=
# WEB_AUTH_PASSWORD=
# WEB_METRICS_TOKEN=

# --- Caddy ---
# Lab default: HTTP on loopback, no IP allowlist (Caddyfile).
CADDY_SITE_ADDRESS=http://:80
CADDY_HTTP_BIND=127.0.0.1
CADDY_HTTP_PORT=80
CADDY_HTTPS_BIND=127.0.0.1
CADDY_HTTPS_PORT=443
CADDY_METRICS_PORT=9091
CADDYFILE=Caddyfile

# Production: public bind + fail-closed allowlist + optional automatic HTTPS.
# CADDYFILE=Caddyfile.restrict
# CADDY_HTTP_BIND=0.0.0.0
# CADDY_HTTPS_BIND=0.0.0.0
# CADDY_SITE_ADDRESS=pulse.example.com
# Space-separated IPs/CIDRs. Empty + Caddyfile.restrict = deny all.
# CADDY_ALLOW_IPS=203.0.113.10 10.8.0.0/24
